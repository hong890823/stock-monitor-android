<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 行情数据：新浪财经 / 东方财富 公开接口 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 盘中价格异动、持仓信号提醒 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 买卖点 / 做 T 提醒震动 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 后台行情监控（前台服务、开机自启） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 可选：申请忽略电池优化，避免长时间挂后台时被系统冻结 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StockMonitor">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ReportActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- stopWithTask=false：划掉最近任务卡片后仍保留后台监控 -->
        <service
            android:name=".monitor.MonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous_market_data_monitoring_and_user_requested_alerts" />
        </service>

        <!-- 工具页用户主动发起的分析任务：临时前台服务，队列空自停 -->
        <service
            android:name=".monitor.AnalysisService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="user_requested_analysis_report_generation" />
        </service>

        <receiver
            android:name=".monitor.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
